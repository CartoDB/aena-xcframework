{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SwiftUIIntegration"},"metadata":{"roleHeading":"API Collection","title":"SwiftUI Integration","platforms":[{"beta":false,"name":"IndoorSDK","introducedAt":"1.6.1"}],"modules":[{"name":"IndoorSDK"}],"role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Since version 1.6.1, IndoorSDK provides native SwiftUI views for indoor mapping, navigation, and parking. All SwiftUI views require "},{"type":"strong","inlineContent":[{"text":"iOS 16+","type":"text"}]},{"type":"text","text":" and must be used inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Display-the-Map","text":"Display the Map"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap"},{"type":"text","text":" to display an airport map. Place it inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["NavigationStack {","    NavigationLink(\"Open Airport\") {","        IndoorMap(icao: \"LEMD\")","    }","}"]},{"level":2,"type":"heading","anchor":"Load-a-POI","text":"Load a POI"},{"inlineContent":[{"type":"text","text":"Open the map focused on a specific POI:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["IndoorMap(icao: \"LEMD\", poiId: 1237556383690)"]},{"level":2,"type":"heading","anchor":"Calculate-a-Route","text":"Calculate a Route"},{"inlineContent":[{"type":"text","text":"Show a route between multiple POIs:"}],"type":"paragraph"},{"syntax":"swift","type":"co