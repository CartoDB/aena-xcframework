{"abstract":[{"type":"text","text":"Use IndoorSDK in SwiftUI applications."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"platforms":[{"beta":false,"introducedAt":"1.6.1","name":"IndoorSDK"}],"title":"SwiftUI Integration","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"IndoorSDK"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since version 1.6.1, IndoorSDK provides native SwiftUI views for indoor mapping, navigation, and parking. All SwiftUI views require "},{"inlineContent":[{"type":"text","text":"iOS 16+"}],"type":"strong"},{"text":" and must be used inside a ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Display-the-Map","text":"Display the Map"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","isActive":true},{"type":"text","text":" to display an airport map. Place it inside a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["NavigationStack {","    NavigationLink(\"Open Airport\") {","        IndoorMap(icao: \"LEMD\")","    }","}"]},{"text":"Load a POI","type":"heading","anchor":"Load-a-POI","level":2},{"type":"paragraph","inlineContent":[{"text":"Open the map focused on a specific POI:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["IndoorMap(icao: \"LEMD\", poiId: 1237556383690)"]},{"level":2,"type":"heading","anchor":"Calculate-a-Route","text":"Calculate a Route"},{"inlineContent":[{"text":"Show a route between multiple POIs:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Route between POIs","IndoorMap(icao: \"LEMD\", startFromUser: false, poisID: [1051091768213, 1237564201940])","","\/\/ Route from user's current position to a POI","IndoorMap(icao: \"LEMD\", startFromUser: true, poisID: [1237564201940])"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Filter-by-Category","text":"Filter by Category"},{"inlineContent":[{"text":"Display the map filtered to a specific category, optionally focused on a terminal and floor:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Show only shops in Terminal 4, Floor 5","IndoorMap(icao: \"LEMD\", filterCategory: 8, focusedOn: (342804, 5))"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Open-a-Category-List","text":"Open a Category List"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","type":"reference","isActive":true},{"text":" to present the category search flow. This pushes the UIKit category list onto the current ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Open shops list — selecting a POI opens the map","Button(\"Show Shops\") {","    CategoryListView.present(categoryId: 8, airportIcao: \"LEMD\")","}","","\/\/ Open PMR list — with a selection callback","Button(\"Show PMR\") {","    CategoryListView.present(categoryId: 16, airportIcao: \"LEMD\") { selectedIds in","        print(\"Selected: \\(selectedIds)\")","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"action"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", selecting a POI in the list opens the map with that POI. When an ","type":"text"},{"type":"codeVoice","code":"action"},{"text":" is provided, the list is dismissed and the callback is fired with the selected POI IDs.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Car-Park","text":"Car Park"},{"level":3,"type":"heading","anchor":"Load-a-Saved-Car-Park","text":"Load a Saved Car Park"},{"type":"codeListing","code":["if let carpark = Carpark.getSavedCarPark() {","    IndoorMap(carpark: carpark)","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Save-a-New-Parking-Location","text":"Save a New Parking Location"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SaveParkingFormView","isActive":true,"type":"reference"},{"text":" for a native SwiftUI parking form:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["NavigationLink(\"Save Parking\") {","    SaveParkingFormView(airportIcao: \"LEMD\") { success in","        if success {","            print(\"Parking saved\")","        }","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Flight-Information","text":"Flight Information"},{"inlineContent":[{"text":"Set a flight to display the flight banner on the map:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@State private var flightActive = false","","Toggle(\"Flight Banner\", isOn: $flightActive)","    .onChange(of: flightActive) { newValue in","        if newValue {","            let flight: [String: String] = [","                \"aeropuertoOrigen\": \"MAD\",","                \"aeropuertoDestino\": \"SCQ\",","                \/\/ ... full flight dictionary","            ]","            try? IndoorModule.shared.setFlight(flight)","        } else {","            try? IndoorModule.shared.setFlight(nil)","        }","    }"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"User-Position","text":"User Position"},{"inlineContent":[{"text":"Query the user’s current position:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["if let position = IndoorModule.shared.getUserPosition() {","    let lon = position[IndoorModule.PositionKey.longitude] as? Double","    let lat = position[IndoorModule.PositionKey.latitude] as? Double","    let isIndoor = position[IndoorModule.PositionKey.isIndoor] as? Bool","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Airport-Info","text":"Airport Info"},{"inlineContent":[{"text":"Request information about an airport:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["IndoorModule.shared.requestAirportInfo(\"LEMD\") { result in","    switch result {","    case .success(let info):","        print(\"\\(info.name) - \\(info.icao)\")","        for building in info.buildings {","            print(\"  \\(building.name): \\(building.floors.count) floors\")","        }","    case .failure(let error):","        print(\"Error: \\(error)\")","    }","}"],"syntax":"swift"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SwiftUIIntegration"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SaveParkingFormView"],"anchor":"Views","title":"Views"},{"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/Carpark","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/AirportInfo"],"anchor":"Model","title":"Model"}],"seeAlsoSections":[{"title":"SwiftUI (iOS 16+, since 1.6.1)","identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\/\/com.geographica.Indo