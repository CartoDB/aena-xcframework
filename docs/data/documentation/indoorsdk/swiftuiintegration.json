ionKey.longitude] as? Double","    let lat = position[IndoorModule.PositionKey.latitude] as? Double","    let isIndoor = position[IndoorModule.PositionKey.isIndoor] as? Bool","}"]},{"level":2,"type":"heading","anchor":"Airport-Info","text":"Airport Info"},{"inlineContent":[{"type":"text","text":"Request information about an airport:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["IndoorModule.shared.requestAirportInfo(\"LEMD\") { result in","    switch result {","    case .success(let info):","        print(\"\\(info.name) - \\(info.icao)\")","        for building in info.buildings {","            print(\"  \\(building.name): \\(building.floors.count) floors\")","        }","    case .failure(let error):","        print(\"Error: \\(error)\")","    }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"type":"text","text":"Use IndoorSDK in SwiftUI applications."}],"topicSections":[{"title":"Views","identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SaveParkingFormView"],"anchor":"Views"},{"title":"Model","identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/Carpark","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/AirportInfo"],"anchor":"Model"}],"seeAlsoSections":[{"anchor":"SwiftUI-iOS-16+-since-161","title":"SwiftUI (iOS 16+, since 1.6.1)","identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\