{"identifier":{"url":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SwiftUIIntegration","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/indoorsdk\/swiftuiintegration"]}],"sections":[],"abstract":[{"type":"text","text":"Use IndoorSDK in SwiftUI applications."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since version 1.6.1, IndoorSDK provides native SwiftUI views for indoor mapping, navigation, and parking. All SwiftUI views require "},{"type":"strong","inlineContent":[{"type":"text","text":"iOS 16+"}]},{"type":"text","text":" and must be used inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Display the Map","level":2,"anchor":"Display-the-Map"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap"},{"type":"text","text":" to display an airport map. Place it inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["NavigationStack {","    NavigationLink(\"Open Airport\") {","        IndoorMap(icao: \"LEMD\")","    }","}"]},{"type":"heading","text":"Load a POI","level":2,"anchor":"Load-a-POI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Open the map focused on a specific POI:"}]},{"type":"codeListing","syntax":"swift","code":["IndoorMap(icao: \"LEMD\", poiId: 1237556383690)"]},{"type":"heading","text":"Calculate a Route","level":2,"anchor":"Calculate-a-Route"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show a route between multiple POIs:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Route between POIs","IndoorMap(icao: \"LEMD\", startFromUser: false, poisID: [1051091768213, 1237564201940])","","\/\/ Route from user's current position to a POI","IndoorMap(icao: \"LEMD\", startFromUser: true, poisID: [1237564201940])"]},{"type":"heading","text":"Filter by Category","level":2,"anchor":"Filter-by-Category"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display the map filtered to a specific category, optionally focused on a terminal and floor:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Show only shops in Terminal 4, Floor 5","IndoorMap(icao: \"LEMD\", filterCategory: 8, focusedOn: (342804, 5))"]},{"type":"heading","text":"Open a Category List","level":2,"anchor":"Open-a-Category-List"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView"},{"type":"text","text":" to present the category search flow. This pushes the UIKit category list onto the current "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Open shops list — selecting a POI opens the map","Button(\"Show Shops\") {","    CategoryListView.present(categoryId: 8, airportIcao: \"LEMD\")","}","","\/\/ Open PMR list — with a selection callback","Button(\"Show PMR\") {","    CategoryListView.present(categoryId: 16, airportIcao: \"LEMD\") { selectedIds in","        print(\"Selected: \\(selectedIds)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"action","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", selecting a POI in the list opens the map with that POI. When an "},{"code":"action","type":"codeVoice"},{"text":" is provided, the list is dismissed and the callback is fired with the selected POI IDs.","type":"text"}]},{"type":"heading","text":"Car Park","level":2,"anchor":"Car-Park"},{"type":"heading","text":"Load a Saved Car Park","level":3,"anchor":"Load-a-Saved-Car-Park"},{"type":"codeListing","syntax":"swift","code":["if let carpark = Carpark.getSavedCarPark() {","    IndoorMap(carpark: carpark)","}"]},{"type":"heading","text":"Save a New Parking Location","level":3,"anchor":"Save-a-New-Parking-Location"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SaveParkingFormView","isActive":true,"type":"reference"},{"text":" for a native SwiftUI parking form:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["NavigationLink(\"Save Parking\") {","    SaveParkingFormView(airportIcao: \"LEMD\") { success in","        if success {","            print(\"Parking saved\")","        }","    }","}"]},{"type":"heading","text":"Flight Information","level":2,"anchor":"Flight-Information"},{"type":"paragraph","inlineContent":[{"text":"Set a flight to display the flight banner on the map:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var flightActive = false","","Toggle(\"Flight Banner\", isOn: $flightActive)","    .onChange(of: flightActive) { newValue in","        if newValue {","            let flight: [String: String] = [","                \"aeropuertoOrigen\": \"MAD\",","                \"aeropuertoDestino\": \"SCQ\",","                \/\/ ... full flight dictionary","            ]","            try? IndoorModule.shared.setFlight(flight)","        } else {","            try? IndoorModule.shared.setFlight(nil)","        }","    }"]},{"type":"heading","text":"User Position","level":2,"anchor":"User-Position"},{"type":"paragraph","inlineContent":[{"text":"Query the user’s current position:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["if let position = IndoorModule.shared.getUserPosition() {","    let lon = position[IndoorModule.PositionKey.longitude] as? Double","    let lat = position[IndoorModule.PositionKey.latitude] as? Double","    let isIndoor = position[IndoorModule.PositionKey.isIndoor] as? Bool","}"]},{"type":"heading","text":"Airport Info","level":2,"anchor":"Airport-Info"},{"type":"paragraph","inlineContent":[{"text":"Request information about an airport:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["IndoorModule.shared.requestAirportInfo(\"LEMD\") { result in","    switch result {","    case .success(let info):","        print(\"\\(info.name) - \\(info.icao)\")","        for building in info.buildings {","            print(\"  \\(building.name): \\(building.floors.count) floors\")","        }","    case .failure(let error):","        print(\"Error: \\(error)\")","    }","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK"]]},"metadata":{"modules":[{"name":"IndoorSDK"}],"roleHeading":"API Collection","platforms":[{"name":"IndoorSDK","introducedAt":"1.6.1","beta":false}],"role":"collectionGroup","title":"SwiftUI Integration"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SaveParkingFormView"],"title":"Views","anchor":"Views"},{"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/Carpark","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/AirportInfo"],"title":"Model","anchor":"Model"}],"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorMap","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/CategoryListView","doc:\/\/com.geographica.IndoorSDK\/documentation\/In