{"hierarchy":{"paths":[["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"IndoorSDK"}],"title":"Outdoor navigation","role":"article"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This functionality let users start an outdoor navigation from your app, and it manage the come back to your app with the user arrive to the airport.","type":"text"}]},{"type":"heading","level":2,"text":"Make outdoor navigation work:","anchor":"Make-outdoor-navigation-work"},{"type":"paragraph","inlineContent":[{"text":"To manage the come back to App, Indoor SDK register several regions alerts, when the user enter of one of them, Indoor SDK evaluate the position and launch a notification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To evaluate region and manage the return through the notification, it’s needed a two step configuration.","type":"text"}]},{"type":"heading","level":3,"text":"UIKit","anchor":"UIKit"},{"type":"heading","level":4,"text":"Step 1: Be sure the location services are on","anchor":"Step-1-Be-sure-the-location-services-are-on"},{"type":"paragraph","inlineContent":[{"text":"To guarantee this you must start IndoorSDK as soon as possible. Be sure you make this in the appropriate method of your appDelegate","type":"text"}]},{"syntax":"swift","code":["func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","                IndoorModule.shared.start()","               \/\/ Override point for customization after application launch.","               return true","               }"],"type":"codeListing"},{"type":"heading","level":4,"text":"Step 2: Manage notification","anchor":"Step-2-Manage-notification"},{"type":"paragraph","inlineContent":[{"text":"When user press the notification to continue with indoor navigation, the app must open in the map to continue with route.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"IndoorSDK provide in its class ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule","isActive":true},{"text":" a method ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule\/manageNotificationResponse(_:andPresentIn:after:prepareToPresent:)","isActive":true},{"text":" to manage this.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You should implement like this in proper method of your appDelegate:","type":"text"}]},{"syntax":"swift","code":["func userNotificationCenter(_ center: UNUserNotificationCenter, didReceive response: UNNotificationResponse, withCompletionHandler completionHandler: @escaping () -> Void) {","","        if IndoorModule.shared.manageNotificationResponse(response, andPresentIn: navController, after: [MainDemoAppTViewController(style: .plain)], prepareToPresent: { self.tabBar.selectedIndex = 1 })","        {","            \/\/ Managed by Indoor module.","            return","        }","            \/\/ Here your notifications implementation.","    }",""],"type":"codeListing"},{"type":"heading","level":3,"text":"SwiftUI — since 1.6.1","anchor":"SwiftUI-since-161"},{"type":"paragraph","inlineContent":[{"text":"IndoorSDK registers regions and sends local notifications automatically. When the user taps the notification, your app must handle the response and show the map with the airport from the notification.","type":"text"}]},{"type":"heading","level":4,"text":"Step 1: Create a notification delegate","anchor":"Step-1-Create-a-notification-delegate"},{"type":"paragraph","inlineContent":[{"text":"Create a ","type":"text"},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"text":" to receive notification responses. The notification ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" contains ","type":"text"},{"code":"\"icao\"","type":"codeVoice"},{"text":" with the airport code and ","type":"text"},{"code":"\"IndoorM\": true","type":"codeVoice"},{"text":" to identify it as an IndoorSDK notification.","type":"text"}]},{"syntax":"swift","code":["class NotificationDelegate: NSObject, UNUserNotificationCenterDelegate {","    var onAirportNotification: ((String) -> Void)?","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                didReceive response: UNNotificationResponse,","                                withCompletionHandler completionHandler: @escaping () -> Void) {","        if let icao = response.notification.request.content.userInfo[\"icao\"] as? String {","            onAirportNotification?(icao)","        }","        completionHandler()","    }","}"],"type":"codeListing"},{"type":"heading","level":4,"text":"Step 2: Wire the delegate in your App struct","anchor":"Step-2-Wire-the-delegate-in-your-App-struct"},{"type":"paragraph","inlineContent":[{"text":"Set the notification delegate and pass the ","type":"text"},{"code":"icao","type":"codeVoice"},{"text":" to your view via state:","type":"text"}]},{"syntax":"swift","code":["@main","struct MyApp: App {","    @State private var notificationIcao: String?","    private let notificationDelegate = NotificationDelegate()","","    init() {","        UNUserNotificationCenter.current().delegate = notificationDelegate","    }","","    var body: some Scene {","        WindowGroup {","            YourFirstView(notificationIcao: $notificationIcao)","                .onAppear {","                    notificationDelegate.onAirportNotification = { icao in","                        notificationIcao = icao","                    }","                }","        }","    }","}"],"type":"codeListing"},{"type":"heading","level":4,"text":"Step 3: Present the map from the notification","anchor":"Step-3-Present-the-map-from-the-notification"},{"type":"paragraph","inlineContent":[{"text":"In your first view, react to the ","type":"text"},{"code":"icao","type":"codeVoice"},{"text":" and navigate to the map:","type":"text"}]},{"syntax":"swift","code":["struct YourFirstView: View {","    @Binding var notificationIcao: String?","","    var body: some View {","        NavigationStack {","            \/\/ Your content","            .navigationDestination(item: $notificationIcao) { icao in","                IndoorMap(icao: icao)","            }","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/OutdoorNavigation","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/GettingStarted","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/SharePosition","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/Geofence","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/DynamicPois","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/ChatbotIntegration","doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/IndoorModule"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"variants":[{"paths":["\/documentation\/indoorsdk\/outdoornavigation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/indoorsdk\/outdoornavigation"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Combine outdoor navigation with dedicated Apps with IndoorSDK"}],"references":{"doc://com.geographica.IndoorSDK/documentation/IndoorSDK/ChatbotIntegration":{"title":"Chatbot integrations","kind":"article","type":"topic","role":"article","url":"\/documentation\/indoorsdk\/chatbotintegration","identifier":"doc:\/\/com.geographica.IndoorSDK\/documentation\/IndoorSDK\/ChatbotIntegration",